---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const postsWithContent = await Promise.all(posts.map(async (post) => ({
  post,
  Content: (await render(post)).Content
})));
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'
}).format(date);
---

<BaseLayout>
  <section class="hero">
    <div>
      <p class="eyebrow">Notes and essays</p>
      <h1>Ideas worth keeping.</h1>
    </div>
    <p class="hero-copy">Writing about technology, creative work, and the details that make both more useful.</p>
  </section>

  <section class="post-list" aria-labelledby="latest-posts">
    <p class="section-label" id="latest-posts">Latest writing</p>
    {postsWithContent.map(({ post, Content }) => (
      <article class="inline-post" id={post.id}>
        <header class="inline-post__header">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <h2>{post.data.title}</h2>
          {post.data.description && <p>{post.data.description}</p>}
          {post.data.tags.length > 0 && (
            <div class="tag-row">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          )}
        </header>
        <div class="prose">
          <Content />
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
