---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ponderous inference in biologic tensor space',
  description = 'Notes, essays, and useful observations.'
} = Astro.props;
const base = import.meta.env.BASE_URL;
const siteRoot = base.endsWith('/') ? base : `${base}/`;
const aboutUrl = `${siteRoot}about/`;
const logoPath = `${siteRoot}centesimiae-logo.png`;
const logoUrl = new URL(logoPath, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={logoUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={logoUrl} />
    <link rel="icon" type="image/png" href={logoPath} />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <div class="header-inner">
          <img class="site-logo" src={logoPath} alt="Centesimiae LLC logo" />
          <nav class="site-nav" aria-label="Main navigation">
            <a href={aboutUrl}>About</a>
          </nav>
        </div>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Centesimiae LLC. All rights reserved.</span>
        <span>Written locally. Published with GitHub Pages.</span>
      </footer>
    </div>
  </body>
</html>
